# -*- makefile -*-

# 使用するツール類の設定
CC = emcc
CXX = em++
LD = em++
MKDEP = mkdep

# 作るライブラリ名の設定
DYLIB_NAME_PREFIX =
DYLIB_NAME_POSTFIX = .js

# 注意:
# このプログラムは wstring を使用しています。
# お使いのコンパイラが wstring を理解しない場合は……どうにかして対処して下さい。

# 追加するフラグ。
CXXFLAGS = -O3 -Wall -std=c++11 -s ALLOW_MEMORY_GROWTH=1
CFLAGS = -O3 -Wall
EXPORTED_FUNCTIONS = "['_load','_unload','_request']"
LDFLAGS = -shared -O3 --memory-init-file 0 --pre-js em-pre.js --post-js em-post.js -s EXPORTED_FUNCTIONS=$(EXPORTED_FUNCTIONS) -s ALLOW_MEMORY_GROWTH=1

################## これより下は弄らなくてもコンパイル出来ます ##################

CXXFLAGS_ADD = -DPOSIX -I.

LIBAYA5_OBJ = \
	aya5.o \
	ayavm.o \
	basis.o \
	ccct.o \
	comment.o \
	crc32.o \
	dir_enum.o \
	duplevinfo.o \
	file.o \
	file1.o \
	function.o \
	globalvariable.o \
	gumbo/src/attribute.o \
	gumbo/src/char_ref.o \
	gumbo/src/char_ref_gperf.o \
	gumbo/src/error.o \
	gumbo/src/parser.o \
	gumbo/src/string_buffer.o \
	gumbo/src/string_piece.o \
	gumbo/src/tag.o \
	gumbo/src/tokenizer.o \
	gumbo/src/utf8.o \
	gumbo/src/util.o \
	gumbo/src/vector.o \
	html.o \
	jsonxml.o \
	lib.o \
	lib1.o \
	localvariable.o \
	log.o \
	logexcode.o \
	manifest.o \
	md5c.o \
	messages.o \
	misc.o \
	mt19937ar.o \
	parson/parson.o \
	parser0.o \
	parser1.o \
	selecter.o \
	sha1.o \
	sqlite3_yaya.o \
	sqlitedb.o \
	sysfunc.o \
	tinyxml2/tinyxml2.o \
	value.o \
	variable.o \
	wsex.o \
	yamltoml.o \
	posix_utils.o

LIBAYA5 = $(DYLIB_NAME_PREFIX)yaya$(DYLIB_NAME_POSTFIX)

all: $(LIBAYA5)

depend:
	mkdep $(CXXFLAGS) $(CXXFLAGS_ADD) $(LIBAYA5_OBJ:.o=.cpp)

clean:
	rm -f $(LIBAYA5) $(LIBAYA5_OBJ)

$(LIBAYA5): $(LIBAYA5_OBJ)
	$(LD) -o $@ $(LIBAYA5_OBJ) $(LDFLAGS)

# SQLiteはCとしてコンパイルする（C++では通らない）
sqlite3_yaya.o: sqlite3_yaya.c sqlite/sqlite3.c
	$(CC) $(CFLAGS) -o $@ -c sqlite3_yaya.c

# GumboはCとしてコンパイルする（C++では通らない）
gumbo/src/attribute.o: gumbo/src/attribute.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/attribute.c
gumbo/src/char_ref.o: gumbo/src/char_ref.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/char_ref.c
gumbo/src/char_ref_gperf.o: gumbo/src/char_ref_gperf.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/char_ref_gperf.c
gumbo/src/error.o: gumbo/src/error.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/error.c
gumbo/src/parser.o: gumbo/src/parser.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/parser.c
gumbo/src/string_buffer.o: gumbo/src/string_buffer.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/string_buffer.c
gumbo/src/string_piece.o: gumbo/src/string_piece.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/string_piece.c
gumbo/src/tag.o: gumbo/src/tag.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/tag.c
gumbo/src/tokenizer.o: gumbo/src/tokenizer.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/tokenizer.c
gumbo/src/utf8.o: gumbo/src/utf8.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/utf8.c
gumbo/src/util.o: gumbo/src/util.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/util.c
gumbo/src/vector.o: gumbo/src/vector.c
	$(CC) $(CFLAGS) -o $@ -c gumbo/src/vector.c

.c.o:
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_ADD) -o $@ -c $<

.cpp.o:
	@iconv -f CP932 -t UTF-8 -c $< > $*.tmp.cpp
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_ADD) -o $@ -c $*.tmp.cpp
	@rm $*.tmp.cpp

#-include .depend

.PHONY: all clean depend

