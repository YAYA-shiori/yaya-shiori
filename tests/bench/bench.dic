B.Toint
{
	_n = _argv[0]
	_i = 0
	_x = 0
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = TOINT('1759650000000')
	}
	B.Out('TOINT(13 digits)', GETTICKCOUNT - _t, _n)
}

B.Replace
{
	_n = _argv[0]
	_i = 0
	_x = ''
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = REPLACE('C:\\Users\\bench\\work\\proj07', '\\', '\')
	}
	B.Out('REPLACE(28 chars)', GETTICKCOUNT - _t, _n)
}

B.ReReplace
{
	_n = _argv[0]
	_i = 0
	_x = ''
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = RE_REPLACE('C:\Users\bench\work\proj07', '[^A-Za-z0-9]', '-')
	}
	B.Out('RE_REPLACE(26 chars)', GETTICKCOUNT - _t, _n)
}

B.Split
{
	_n = _argv[0]
	_i = 0
	_x = IARRAY
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = SPLIT('1759650000000|aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee', '|')
	}
	B.Out('SPLIT(2 parts)', GETTICKCOUNT - _t, _n)
}

B.Getenv
{
	_n = _argv[0]
	_i = 0
	_x = ''
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = GETENV('USERPROFILE')
	}
	B.Out('GETENV', GETTICKCOUNT - _t, _n)
}

B.Gettime
{
	_n = _argv[0]
	_i = 0
	_x = IARRAY
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = GETTIME(1759650000)
	}
	B.Out('GETTIME', GETTICKCOUNT - _t, _n)
