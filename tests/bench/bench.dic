//******************************************************************************
// マイクロ・ベンチ: 作業履歴の頁（Claudia の CC.PageHist / CCS.Span）が使う処理を、要素ごとに分けて測る
//   各関数は _argv[0] 回くり返し、1 回あたりのマイクロ秒を文字列で返す（ファイル系の B.FreadAll 等は 1 行あたり）
//   時計は GETTICKCOUNT（約 15ms 刻み）なので、回数は 1 本が 200ms 以上になるよう選ぶこと
//   ループの回数には looplimit（既定 10000）がかかる。yaya.txt で looplimit, 0 にしてあるが、
//   辞書を移すときは忘れないこと（10000 を超えると黙って打ち切られ、1 回あたりの値が小さく出る）
//   実データ（~/.claude/history.jsonl）と同じ形の合成データを %USERPROFILE% に置いて使う（gen-data.ps1）
//******************************************************************************

load
{
}

unload
{
}

request
{
	'!! ' + EVAL(SUBSTR(_argv[0], 3, STRLEN(_argv[0])))
}

B.Out
{
	_argv[0] + ': ' + TOSTR(TOREAL(_argv[1]) * 1000.0 / _argv[2]) + ' us/op'
}

B.HistPath
{
	REPLACE(GETENV('USERPROFILE'), '\', '/') + '/.claude/history.jsonl'
}

//---- 履歴の 1 行（実データと同じ形）。bline に覚える
B.Line
{
	_path = B.HistPath
	_i    = 0
	if FOPEN(_path, 'r') {
		for _i = 0 ; _i < 3000 ; _i++ {
			bline = FREAD(_path)
		}
		void FCLOSE(_path)
	}
	STRLEN(bline)
}

B.Nop
{
	0
}

B.Id
{
	_argv[0]
}

//------------------------------------------------------------------------------
//インタプリタそのもの
//------------------------------------------------------------------------------
B.Loop
{
	_n = _argv[0]
	_i = 0
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
	}
	B.Out('empty loop iteration', GETTICKCOUNT - _t, _n)
}

B.Assign
{
	_n = _argv[0]
	_i = 0
	_x = 0
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = _i + 1
	}
	B.Out('assign _x = _i + 1', GETTICKCOUNT - _t, _n)
}

B.If
{
	_n = _argv[0]
	_i = 0
	_x = 0
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		if _i < 0 {
			_x = 1
		}
		elseif _i == -1 {
			_x = 2
		}
		else {
			_x = 3
		}
	}
	B.Out('if/elseif/else', GETTICKCOUNT - _t, _n)
}

B.Call0
{
	_n = _argv[0]
	_i = 0
	_x = 0
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = B.Nop
	}
	B.Out('call user func (no arg)', GETTICKCOUNT - _t, _n)
}

B.Call1
{
	_n = _argv[0]
	_i = 0
	_x = 0
	_t = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = B.Id(_i)
	}
	B.Out('call user func (1 arg)', GETTICKCOUNT - _t, _n)
}

//------------------------------------------------------------------------------
//文字列
//------------------------------------------------------------------------------
B.Strstr
{
	_n  = _argv[0]
	_i  = 0
	_x  = 0
	_ln = bline
	_t  = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = STRSTR(_ln, '"sessionId":"', 0)
	}
	B.Out('STRSTR on history line (' + STRLEN(_ln) + ' chars)', GETTICKCOUNT - _t, _n)
}

B.StrstrShort
{
	_n  = _argv[0]
	_i  = 0
	_x  = 0
	_ln = 'abcdefghij"sessionId":"klmnop'
	_t  = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = STRSTR(_ln, '"sessionId":"', 0)
	}
	B.Out('STRSTR on 30-char string', GETTICKCOUNT - _t, _n)
}

B.Substr
{
	_n  = _argv[0]
	_i  = 0
	_x  = ''
	_ln = bline
	_t  = GETTICKCOUNT
	for _i = 0 ; _i < _n ; _i++ {
		_x = SUBSTR(_ln, 100, 36)
	}
	B.Out('SUBSTR(line, 100, 36)', GETTICKCOUNT - _t, _n)
}

B.Strlen
{
	_n  = _argv[0]
